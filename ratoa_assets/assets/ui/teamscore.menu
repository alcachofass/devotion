#include "ui/menudef.h"

/*
 * Simple team scoreboard panel for Menu HUD mode (teamscore_menu).
 */
{
	menuDef {
		name "teamscore_menu"
		fullScreen MENU_FALSE
		visible MENU_FALSE
		rect 40 50 560 380
		style WINDOW_STYLE_FILLED
		backcolor 0 0 0 0.7
		border 1
		bordercolor 1 1 1 0.35

		itemDef {
			name "title"
			rect 0 8 560 22
			visible 1
			decoration
			text "TEAM SCOREBOARD"
			textalign ITEM_ALIGN_CENTER
			textscale 0.38
			forecolor 1 1 1 1
			textstyle ITEM_TEXTSTYLE_SHADOWED
		}
		itemDef {
			name "redName"
			rect 20 36 240 18
			visible 1
			decoration
			textalign ITEM_ALIGN_CENTER
			textscale 0.28
			forecolor 1 0.3 0.3 1
			textstyle ITEM_TEXTSTYLE_SHADOWED
			ownerdraw CG_RED_NAME
		}
		itemDef {
			name "redScore"
			rect 20 54 240 18
			visible 1
			decoration
			textalign ITEM_ALIGN_CENTER
			textscale 0.32
			forecolor 1 0.4 0.4 1
			textstyle ITEM_TEXTSTYLE_SHADOWED
			ownerdraw CG_RED_SCORE
		}
		itemDef {
			name "blueName"
			rect 300 36 240 18
			visible 1
			decoration
			textalign ITEM_ALIGN_CENTER
			textscale 0.28
			forecolor 0.4 0.5 1 1
			textstyle ITEM_TEXTSTYLE_SHADOWED
			ownerdraw CG_BLUE_NAME
		}
		itemDef {
			name "blueScore"
			rect 300 54 240 18
			visible 1
			decoration
			textalign ITEM_ALIGN_CENTER
			textscale 0.32
			forecolor 0.5 0.6 1 1
			textstyle ITEM_TEXTSTYLE_SHADOWED
			ownerdraw CG_BLUE_SCORE
		}
		/* Red column headers — name / score / ping */
		itemDef {
			name "redHdrName"
			rect 24 78 140 12
			visible 1
			decoration
			text "NAME"
			textalign ITEM_ALIGN_LEFT
			textscale 0.18
			forecolor 0.85 0.7 0.7 1
			textstyle ITEM_TEXTSTYLE_SHADOWED
		}
		itemDef {
			name "redHdrScore"
			rect 194 78 40 12
			visible 1
			decoration
			text "SCORE"
			textalign ITEM_ALIGN_LEFT
			textscale 0.18
			forecolor 0.85 0.7 0.7 1
			textstyle ITEM_TEXTSTYLE_SHADOWED
		}
		itemDef {
			name "redHdrPing"
			rect 234 78 36 12
			visible 1
			decoration
			text "PING"
			textalign ITEM_ALIGN_LEFT
			textscale 0.18
			forecolor 0.85 0.7 0.7 1
			textstyle ITEM_TEXTSTYLE_SHADOWED
		}
		/* Blue column headers */
		itemDef {
			name "blueHdrName"
			rect 294 78 140 12
			visible 1
			decoration
			text "NAME"
			textalign ITEM_ALIGN_LEFT
			textscale 0.18
			forecolor 0.7 0.75 0.9 1
			textstyle ITEM_TEXTSTYLE_SHADOWED
		}
		itemDef {
			name "blueHdrScore"
			rect 464 78 40 12
			visible 1
			decoration
			text "SCORE"
			textalign ITEM_ALIGN_LEFT
			textscale 0.18
			forecolor 0.7 0.75 0.9 1
			textstyle ITEM_TEXTSTYLE_SHADOWED
		}
		itemDef {
			name "blueHdrPing"
			rect 504 78 36 12
			visible 1
			decoration
			text "PING"
			textalign ITEM_ALIGN_LEFT
			textscale 0.18
			forecolor 0.7 0.75 0.9 1
			textstyle ITEM_TEXTSTYLE_SHADOWED
		}
		itemDef {
			name "redlist"
			rect 20 92 250 268
			type ITEM_TYPE_LISTBOX
			style WINDOW_STYLE_FILLED
			background "white"
			backcolor 0.15 0.02 0.02 0.55
			forecolor 1 1 1 1
			border 1
			bordercolor 0.6 0.2 0.2 0.5
			textscale 0.20
			feeder FEEDER_REDTEAM_LIST
			elementwidth 250
			elementheight 16
			elementtype LISTBOX_TEXT
			columns 3 0 0 20 170 0 6 210 0 5
			visible 1
		}
		itemDef {
			name "bluelist"
			rect 290 92 250 268
			type ITEM_TYPE_LISTBOX
			style WINDOW_STYLE_FILLED
			background "white"
			backcolor 0.02 0.02 0.15 0.55
			forecolor 1 1 1 1
			border 1
			bordercolor 0.2 0.3 0.7 0.5
			textscale 0.20
			feeder FEEDER_BLUETEAM_LIST
			elementwidth 250
			elementheight 16
			elementtype LISTBOX_TEXT
			columns 3 0 0 20 170 0 6 210 0 5
			visible 1
		}
	}
}
