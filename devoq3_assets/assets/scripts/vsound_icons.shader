// Vsound icon shaders. tcMod flips TGA origin for 2D stretch pics.

icons/vsound/light/bfg
{
	nopicmip
	nomipmaps
	cull none
	{
		clampmap icons/vsound/light/bfg.tga
		blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		rgbGen vertex
		alphaGen vertex
		tcMod transform 1 0 0 -1 0 1
	}
}

