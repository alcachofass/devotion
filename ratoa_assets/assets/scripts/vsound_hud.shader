// Vertex-alpha wrappers for stock HUD icons. The original icons/iconw_* shaders
// use alphaGen oneMinusEntity, which ignores 2D SetColor fade.

icons/vsound/hud/iconw_gauntlet
{
	nopicmip
	{
		clampmap icons/iconw_gauntlet.tga
		blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		rgbGen vertex
		alphaGen vertex
	}
}

